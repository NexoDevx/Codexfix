        <item name="colorPrimary">#0D0F14</item>
        <item name="colorPrimaryDark">#0D0F14</item>
        <item name="colorAccent">#D97757</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
